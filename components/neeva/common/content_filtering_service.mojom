module neeva.mojom;

enum ContentFilterMode {
  BLOCK_COOKIES,
  BLOCK_REQUESTS
};

struct ContentFilterRules {
  ContentFilterMode mode;
  array<string> top_level_host_exclusions;

  // Where the rules can be found.
  handle<platform> rules_data_fd;
  uint64 rules_data_offset;
  uint64 rules_data_size;
};

struct ContentFilterAction {
  string host;
};

interface ContentFilterRulesListener {
  OnReceiveNewRules(ContentFilterRules? rules);
};

interface ContentFilteringService {
  AddRulesListener(pending_remote<ContentFilterRulesListener> listener);

  // When a child process filters content, it calls OnContentFiltered to let the
  // service know about it. `render_frame_id` identifies the frame in which content
  // was blocked and `action` indicates what was blocked. (The service can map the
  // render_frame_id to the corresponding tab.)
  OnContentFiltered(int32 render_frame_id, ContentFilterAction action);
};
